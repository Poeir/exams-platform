# Copy to .env for local dev. In deployed environments these come from the
# platform (secrets via Key Vault), never from a file in the image.

# Shared database (both engines; english owns english+shared schemas, mbti owns mbti)
DATABASE_URL=sqlserver://localhost:1433;database=gofive_assessments;user=sa;password=Your_password123;encrypt=true;trustServerCertificate=true

# Gateway port (the only listener in the container)
PORT=3000

# ONE parent key for both engines — header X-API-Key on every parent call
PARENT_API_KEY=dev-parent-key
# Optional: explicit signing secret for result view links (defaults derive from PARENT_API_KEY)
# VIEW_LINK_SECRET=

# Public URLs of each engine AS SEEN BY BROWSERS — used to mint launch/view links
ENGINE_PUBLIC_URL=http://localhost:3000/english
FRONTEND_URL=http://localhost:3000/mbti

# english extras
LAUNCH_TOKEN_TTL_MIN=30
DEFAULT_TIME_LIMIT_MIN=60
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
CLOUDINARY_CLOUD_NAME=deqk2coqu
CLOUDINARY_UPLOAD_PRESET=english_test_media

# mbti extras
ATTEMPT_TTL_MINUTES=120
# VIEW_LINK_TTL_MINUTES=15
# WEBHOOK_TIMEOUT_MS=8000
# WEBHOOK_MAX_ATTEMPTS=5
