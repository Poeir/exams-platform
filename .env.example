# Copy to .env for local dev. In deployed environments these come from the
# platform (secrets via Key Vault), never from a file in the image.

# ============================== REQUIRED ====================================
# Shared database (english owns english+shared schemas, mbti owns mbti)
DATABASE_URL=sqlserver://localhost:1433;database=gofive_assessments;user=sa;password=Your_password123;encrypt=true;trustServerCertificate=true

# ONE parent key for both engines — header X-API-Key on every parent call
PARENT_API_KEY=dev-parent-key

# Public origin of the gateway as seen by BROWSERS (no trailing slash, no
# prefix). Each engine derives its own URL from it: <base>/english, <base>/mbti
# — used to mint launchUrl / view links handed to the parent site.
PUBLIC_BASE_URL=http://localhost:3000

# ====================== OPTIONAL (sane defaults) ============================
# english admin UI — UNSET means admin endpoints are disabled (503)
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=change-me

# Azure Blob Storage for english admin media (images/audio). UNSET means uploads
# are disabled. The account has public read off, so the server proxies both
# upload and read through a container-scoped SAS (rotatable without code change).
# AZURE_STORAGE_ACCOUNT=examostorage
# AZURE_STORAGE_CONTAINER=dev
# AZURE_STORAGE_SAS=sp=racwl&st=...&se=...&spr=https&sv=...&sr=c&sig=...

# Gateway port (default 3000)
# PORT=3000

# Per-engine URL overrides — only if an engine must live somewhere OTHER than
# PUBLIC_BASE_URL + its prefix (e.g. standalone deploys)
# ENGINE_PUBLIC_URL=
# FRONTEND_URL=

# Token/window tuning (defaults shown)
# LAUNCH_TOKEN_TTL_MIN=30          # english launch link lifetime
# DEFAULT_TIME_LIMIT_MIN=60        # english fallback exam time limit
# ATTEMPT_TTL_MINUTES=120          # mbti attempt lifetime
# VIEW_LINK_TTL_MIN=15             # view-link lifetime (both engines)
# VIEW_LINK_SECRET=                # defaults derive from PARENT_API_KEY — set explicitly in prod
# WEBHOOK_TIMEOUT_MS=8000
# WEBHOOK_MAX_ATTEMPTS=5
