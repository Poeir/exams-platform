# Copy to .env for local dev. In deploy these come from the platform (Key Vault).

# === REQUIRED ===
# DB: managed identity only (no password). Host + auth are hardcoded in each
# app's dbConfig.js; only the database name is env-driven.
DB_DATABASE=examo_dev

# Parent shared secret — header X-API-Key on every parent call
PARENT_API_KEY=dev-parent-key

# Gateway origin browsers see (no trailing slash/prefix); engines derive
# <base>/english and <base>/mbti for launch/view links.
PUBLIC_BASE_URL=http://localhost:3000

# === OPTIONAL (defaults shown) ===
# english admin UI — unset = admin disabled (503)
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=change-me

# english admin media uploads (Azure Blob) — unset = uploads disabled
# AZURE_STORAGE_ACCOUNT=examostorage
# AZURE_STORAGE_CONTAINER=dev
# AZURE_STORAGE_SAS=sp=racwl&st=...&se=...&sig=...

# PORT=3000
# ENGINE_PUBLIC_URL=  /  FRONTEND_URL=          # per-engine URL overrides
# VIEW_LINK_SECRET=                             # set in prod; defaults from PARENT_API_KEY
# LAUNCH_TOKEN_TTL_MIN=30  DEFAULT_TIME_LIMIT_MIN=60  ATTEMPT_TTL_MINUTES=120
# VIEW_LINK_TTL_MIN=15  WEBHOOK_TIMEOUT_MS=8000  WEBHOOK_MAX_ATTEMPTS=5

# DATABASE_URL is Prisma-CLI-only (english migrate/seed, out-of-band SQL auth) —
# NOT a runtime/deploy var. Set it transiently on the machine that runs migrations.
