english-test-remix
handoff
.git
.gitignore
.vscode
.idea
*.log

# Tests & CI artifacts not needed at runtime
**/*.test.js
**/*.test.jsx
playwright-report
test-results

# Docker meta
Dockerfile
.dockerignore
