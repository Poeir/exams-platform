# Standalone-dev env for the english server.
# DB: managed identity only; host + auth hardcoded in src/dbConfig.js, only the
# database name is env-driven.
DB_DATABASE=examo_dev
PORT=3002                       # code default 3001 collides with mbti
PARENT_API_KEY=dev-parent-key   # unset = parent endpoints answer 503

# admin UI + admin API (HTTP Basic) — unset = admin disabled (503)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme

# admin media uploads (Azure Blob) — unset = uploads answer 503
AZURE_STORAGE_ACCOUNT=examostorage
AZURE_STORAGE_CONTAINER=dev
AZURE_STORAGE_SAS=sp=racwl&st=...&se=...&sig=...

# Optional (defaults shown):
# ENGINE_PUBLIC_URL=http://localhost:5175
# LAUNCH_TOKEN_TTL_MIN=30  DEFAULT_TIME_LIMIT_MIN=60  VIEW_LINK_TTL_MIN=15
# VIEW_LINK_SECRET=   WEBHOOK_TIMEOUT_MS=8000   WEBHOOK_MAX_ATTEMPTS=5

# DATABASE_URL is Prisma-CLI-only (migrate/seed/studio), NOT runtime. e.g.:
# DATABASE_URL=sqlserver://localhost:1433;database=exams_assessments;user=sa;password=Your_password123;encrypt=true;trustServerCertificate=true
