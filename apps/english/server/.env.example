# Standalone-dev env for the english app's server. Required: DATABASE_URL,
# PORT (code default 3001 collides with mbti), PARENT_API_KEY (no code default
# by design — unset means parent endpoints return 503).
DATABASE_URL=sqlserver://localhost:1433;database=gofive_assessments;user=sa;password=Your_password123;encrypt=true;trustServerCertificate=true
PORT=3002
PARENT_API_KEY=dev-parent-key

# HTTP Basic credentials for the admin UI + admin-only API routes.
# UNSET means every admin endpoint answers 503 (admin disabled).
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme

# Cloudinary (unsigned uploads). Served to the browser via GET /api/config so
# the frontend bundle stays config-free. These values are public by design.
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_UPLOAD_PRESET=your_unsigned_preset

# Optional overrides (defaults shown):
# ENGINE_PUBLIC_URL=http://localhost:5175  # public URL used in launch/view links
# LAUNCH_TOKEN_TTL_MIN=30
# DEFAULT_TIME_LIMIT_MIN=60
# VIEW_LINK_TTL_MIN=15
# VIEW_LINK_SECRET=                        # derived from PARENT_API_KEY when unset
# WEBHOOK_TIMEOUT_MS=8000
# WEBHOOK_MAX_ATTEMPTS=5
