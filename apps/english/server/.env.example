# Prisma connection string. Now SQL Server / Azure SQL so this service can share
# one database with the mbti-personality service (see docs/unified-db-plan.md).
DATABASE_URL=sqlserver://localhost:1433;database=gofive_assessments;user=sa;password=Your_password123;encrypt=true;trustServerCertificate=true
# NOTE: mbti-personality's server also defaults to PORT 3001. When running both
# locally against the shared DB, give one of them a different port.
PORT=3002

# HTTP Basic credentials for the admin UI + admin-only API routes.
# Routes that mutate content (POST/PATCH/DELETE on papers/sections/items),
# the seed endpoint, and the admin view of GET /api/papers/:id?withAnswers=1
# require these. Browser prompts natively on 401.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme

# Shared secret for server-to-server calls from the parent site.
# Used to authenticate POST /api/sessions and to sign result webhooks
# (X-Signature: sha256=<hmac>). Pick a long random string in production.
PARENT_API_KEY=changeme

# Public base URL of THIS engine — used to build the launch_url returned to
# the parent (parent then opens this URL in a new tab for the candidate).
ENGINE_PUBLIC_URL=http://localhost:5175

# How long a launch_token is valid before the candidate has to be re-issued
# a new session.
LAUNCH_TOKEN_TTL_MIN=30

# Default time limit applied to attempts when the parent doesn't specify one.
DEFAULT_TIME_LIMIT_MIN=60

# Webhook delivery retry settings.
WEBHOOK_TIMEOUT_MS=8000
WEBHOOK_MAX_ATTEMPTS=5

# Cloudinary (unsigned uploads). Served to the browser via GET /api/config so
# the frontend bundle stays config-free. These values are public by design.
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_UPLOAD_PRESET=your_unsigned_preset
