# Standalone-dev env for the mbti app.
# DB: managed identity only; host + auth hardcoded in server/dbConfig.js, only the
# database name is env-driven. mbti applies its schema via SQL scripts (no Prisma
# CLI), so it never needs DATABASE_URL.
DB_DATABASE=examo_dev

# Optional (defaults shown):
# PORT=3001
# FRONTEND_URL=http://localhost:5174
# PARENT_API_KEY=dev-parent-key   # X-API-Key (same key as english)
# ATTEMPT_TTL_MINUTES=120  VIEW_LINK_TTL_MIN=15  VIEW_LINK_SECRET=
# WEBHOOK_TIMEOUT_MS=8000  WEBHOOK_MAX_ATTEMPTS=5
