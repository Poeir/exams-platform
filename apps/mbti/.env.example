# Standalone-dev env for the mbti app. Only DATABASE_URL is required — every
# other knob has a dev default in server/config.js.
DATABASE_URL=sqlserver://localhost:1433;database=gofive_assessments;user=sa;password=Your_password123;encrypt=true;trustServerCertificate=true

# Optional overrides (defaults shown):
# PORT=3001
# FRONTEND_URL=http://localhost:5174   # public URL used to mint view links
# PARENT_API_KEY=dev-parent-key        # X-API-Key (legacy PARENT_SERVICE_KEY still works)
# ATTEMPT_TTL_MINUTES=120
# VIEW_LINK_TTL_MINUTES=15
# VIEW_LINK_SECRET=                    # derived from PARENT_API_KEY when unset
# WEBHOOK_TIMEOUT_MS=8000
# WEBHOOK_MAX_ATTEMPTS=5
